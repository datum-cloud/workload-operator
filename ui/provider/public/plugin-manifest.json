{
  "name": "workloads.staff-portal.datumapis.com",
  "version": "0.6.0",
  "sdk": {
    "name": "@datum-cloud/portal-plugin-sdk",
    "range": "^1.0.0"
  },
  "remoteEntry": "remoteEntry.js",
  "exposedModules": {
    "WorkloadList": "./src/pages/workload-list.tsx",
    "WorkloadDetail": "./src/pages/workload-detail.tsx",
    "FleetWorkloads": "./src/pages/fleet-workloads.tsx",
    "ServiceOverview": "./src/pages/service-overview.tsx"
  },
  "extensions": [
    {
      "type": "portal.resource/platform",
      "properties": {
        "id": "compute-workload",
        "type": "workload",
        "label": "Workload",
        "icon": "box",
        "searchTarget": {
          "group": "compute.datumapis.com",
          "version": "v1alpha",
          "kind": "Workload"
        }
      }
    },
    {
      "type": "portal.page/project",
      "properties": {
        "id": "compute-workload-list",
        "path": "",
        "component": { "$codeRef": "WorkloadList" }
      }
    },
    {
      "type": "portal.page/project",
      "properties": {
        "id": "compute-workload-detail",
        "path": ":workloadName",
        "component": { "$codeRef": "WorkloadDetail" }
      }
    },
    {
      "type": "portal.page/service",
      "properties": {
        "id": "compute-fleet-workloads",
        "label": "Workloads",
        "path": "workloads",
        "component": { "$codeRef": "FleetWorkloads" }
      }
    },
    {
      "type": "portal.page/service",
      "properties": {
        "id": "compute-service-overview",
        "label": "Overview",
        "path": "",
        "component": { "$codeRef": "ServiceOverview" }
      }
    }
  ]
}
